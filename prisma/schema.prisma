

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Crop {
  id        Int      @id @default(autoincrement())
  name      String
  growth    String
  createdAt DateTime @default(now())
}

model Yield {
  id        Int      @id @default(autoincrement())
  amount    Float
  createdAt DateTime @default(now())
}